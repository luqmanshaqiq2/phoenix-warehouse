@phoenix_warehouse_HostAddress = http://localhost:5059

### Health
GET {{phoenix_warehouse_HostAddress}}/health
Accept: application/json

### Get products
GET {{phoenix_warehouse_HostAddress}}/products
Accept: application/json

### Get a product
GET {{phoenix_warehouse_HostAddress}}/products/00000000-0000-0000-0000-000000000000
Accept: application/json

### Create a product
POST {{phoenix_warehouse_HostAddress}}/products
Content-Type: application/json

{
  "sku": "SKU-1004",
  "productName": "Cordless Saw",
  "price": 199.99,
  "isAvailable": true,
  "quantity": 12
}

### Get warehouses
GET {{phoenix_warehouse_HostAddress}}/warehouses
Accept: application/json

### Create a warehouse
POST {{phoenix_warehouse_HostAddress}}/warehouses
Content-Type: application/json

{
  "name": "East Hub",
  "location": "New York, NY",
  "capacity": 2500
}

### Get inventory
GET {{phoenix_warehouse_HostAddress}}/inventory
Accept: application/json

### Create inventory
POST {{phoenix_warehouse_HostAddress}}/inventory
Content-Type: application/json

{
  "productId": "00000000-0000-0000-0000-000000000000",
  "warehouseId": "00000000-0000-0000-0000-000000000000",
  "quantityOnHand": 10,
  "reservedQuantity": 0,
  "reorderLevel": 2
}

### Adjust inventory
PATCH {{phoenix_warehouse_HostAddress}}/inventory/00000000-0000-0000-0000-000000000000/adjust
Content-Type: application/json

{
  "quantityDelta": 5
}

### Get customers
GET {{phoenix_warehouse_HostAddress}}/customers
Accept: application/json

### Create a customer
POST {{phoenix_warehouse_HostAddress}}/customers
Content-Type: application/json

{
  "firstName": "Jamie",
  "lastName": "Rivera",
  "email": "jamie.rivera@example.com",
  "phoneNumber": "555-0103"
}

### Get orders
GET {{phoenix_warehouse_HostAddress}}/orders
Accept: application/json

### Create an order
POST {{phoenix_warehouse_HostAddress}}/orders
Content-Type: application/json

{
  "customerId": "00000000-0000-0000-0000-000000000000",
  "items": [
    {
      "productId": "00000000-0000-0000-0000-000000000000",
      "quantity": 2
    }
  ]
}

### Update order status
PATCH {{phoenix_warehouse_HostAddress}}/orders/00000000-0000-0000-0000-000000000000/status
Content-Type: application/json

{
  "status": "Processing"
}

### Get stock movements
GET {{phoenix_warehouse_HostAddress}}/stock-movements
Accept: application/json

### Get inventory reservations
GET {{phoenix_warehouse_HostAddress}}/inventory-reservations
Accept: application/json
